{
  "name": "desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desk: a reading and writing practice. Booklets to read, handwritten drafts to work, submissions to track.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "pagedjs": "^0.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
